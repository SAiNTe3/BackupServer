<UserControl x:Class="BackupServer.Components.ServerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BackupServer.Components"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- HTTP API服务器控制面板 -->
        <Border Grid.Row="0" Background="White" Margin="10" Padding="15" 
            BorderBrush="#E5E6E8" BorderThickness="1" CornerRadius="5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="HTTP API服务器控制:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
                <TextBox x:Name="PortTextBox" Width="80" Height="25" Text="8888" 
                    VerticalContentAlignment="Center" Margin="0,0,5,0"/>
                
                <Button x:Name="StartServerButton" Content="启动服务器" Width="80" Height="25" 
                    Click="StartServerButton_Click" Margin="0,0,5,0"/>
                <Button x:Name="StopServerButton" Content="停止服务器" Width="80" Height="25" 
                    Click="StopServerButton_Click" Margin="0,0,5,0"/>
                <Button x:Name="TestConnectionButton" Content="测试连接" Width="80" Height="25" 
                    Click="TestConnectionButton_Click" Margin="0,0,5,0"/>
                <Button x:Name="ClearLogButton" Content="清除日志" Width="80" Height="25" 
                    Click="ClearLogButton_Click" Margin="0,0,10,0"/>
                <TextBlock x:Name="ServerStatusTextBlock" Text="服务器状态: 未启动" 
                    VerticalAlignment="Center" Foreground="#666"/>
            </StackPanel>
        </Border>

        <!-- 消息显示区域 -->
        <Border Grid.Row="1" Background="White" Margin="10" Padding="15" 
            BorderBrush="#E5E6E8" BorderThickness="1" CornerRadius="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="HTTP请求日志:" FontWeight="Bold" Margin="0,0,0,10"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="MessageLogTextBox" IsReadOnly="True" 
                        TextWrapping="Wrap" AcceptsReturn="True" 
                        Background="Transparent" BorderThickness="0"
                        FontFamily="Consolas" FontSize="12"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
