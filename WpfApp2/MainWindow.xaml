<Window x:Class="BackupServer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BackupServer"
        xmlns:components="clr-namespace:BackupServer.Components"
        mc:Ignorable="d"
        Title="图片备份" Height="720" Width="1000">
    <Window.Resources>
        
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="6*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SiderBarColumn" Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <components:SideBarMenu Grid.Column="0"/>
            
            <Border x:Name="MainBorder" Grid.Column="1">
                <Grid Background="#F7F9FC">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="80"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <ContentControl x:Name="MainContentControl" Grid.Row="1">
                        <!-- 默认显示 ServerView -->
                        <components:ServerView/>
                    </ContentControl>

                    <!-- 添加 ServerView 组件 -->
                    <components:ServerView x:Name="ServerView" Grid.Row="1"/>

                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="1">
            <Border Background="#FAFAFA" BorderThickness="0,1,0,0" BorderBrush="#E5E6E8" Padding="20,10">
                <TextBlock x:Name="StatusTextBlock" Text="HTTP API服务器就绪" VerticalAlignment="Center" FontSize="12" Foreground="#666"/>
            </Border>
        </Grid>
    </Grid>
</Window>
